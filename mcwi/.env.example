# MCWI Environment Variables
# Copy this file to .env.local and fill in your values
# 
# Documentation: https://github.com/reversesingularity/autonomous-lunar-logistics

# ============================================================================
# Supabase Configuration (Required for real-time features)
# Get your keys from: https://app.supabase.com/project/_/settings/api
# ============================================================================

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous (Public) Key - safe to expose in client-side code
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# CesiumJS Configuration (Required for 3D globe)
# Get free token at: https://cesium.com/ion/
# ============================================================================

VITE_CESIUM_ION_TOKEN=your-cesium-ion-token

# ============================================================================
# Optional Configuration
# ============================================================================

# Enable/Disable real-time subscriptions (default: true)
# Set to false to use polling instead for reduced bandwidth
VITE_ENABLE_REALTIME=true

# Polling interval in milliseconds when realtime is disabled (default: 5000)
VITE_POLL_INTERVAL=5000

# Enable mock data when Supabase is not configured (default: auto-detect)
# Automatically enabled if VITE_SUPABASE_URL is not set
VITE_USE_MOCK_DATA=false

# Log level for debugging (debug, info, warn, error)
VITE_LOG_LEVEL=info
